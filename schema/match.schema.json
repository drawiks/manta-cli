{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/drawiks/manta-cli/schema/match.schema.json",
  "title": "manta-cli match",
  "type": "object",
  "additionalProperties": false,
  "required": ["match_id", "duration_sec", "radiant_win", "players"],
  "properties": {
    "match_id": { "type": "integer" },
    "duration_sec": { "type": "number" },
    "radiant_win": { "type": "boolean" },
    "players": {
      "type": "array",
      "items": { "$ref": "#/$defs/player" }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inflictor", "category"],
      "properties": {
        "inflictor": { "type": "string" },
        "category": { "type": "string" },
        "duration": { "type": "number" },
        "value": { "type": "number" },
        "count": { "type": "integer" }
      }
    },
    "player": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "steam_id", "player_id", "hero_id", "hero", "team", "name",
        "kills", "deaths", "assists", "level", "last_hits", "networth",
        "gpm", "xpm", "healing", "hero_damage", "damage_taken",
        "tower_damage", "time_dead", "stun_duration", "buff_duration",
        "fear_duration", "roots_duration", "leash_duration", "trap_duration",
        "taunt_duration", "silence_duration", "break_duration",
        "disarm_duration", "heal_duration", "heal_value",
        "gold_spent_wards", "gold_spent_smoke", "gold_spent_dust",
        "gold_lost", "camps_stacked", "creeps_stacked", "rune_pickups",
        "wisdoms_captured", "watchers_captured", "lotuses_gathered",
        "first_blood", "courier_kills"
      ],
      "properties": {
        "steam_id": { "type": "integer" },
        "player_id": { "type": "integer" },
        "hero_id": { "type": "integer" },
        "hero": { "type": "string" },
        "team": { "type": "string" },
        "name": { "type": "string" },
        "position": { "type": "integer" },
        "lane": { "type": "string" },
        "kills": { "type": "integer" },
        "deaths": { "type": "integer" },
        "assists": { "type": "integer" },
        "level": { "type": "integer" },
        "last_hits": { "type": "integer" },
        "networth": { "type": "integer" },
        "gpm": { "type": "integer" },
        "xpm": { "type": "integer" },
        "healing": { "type": "integer" },
        "hero_damage": { "type": "integer" },
        "damage_taken": { "type": "integer" },
        "tower_damage": { "type": "integer" },
        "time_dead": { "type": "number" },
        "stun_duration": { "type": "number" },
        "stun_sources": { "type": "array", "items": { "$ref": "#/$defs/source" } },
        "buff_duration": { "type": "number" },
        "buff_sources": { "type": "array", "items": { "$ref": "#/$defs/source" } },
        "fear_duration": { "type": "number" },
        "fear_sources": { "type": "array", "items": { "$ref": "#/$defs/source" } },
        "roots_duration": { "type": "number" },
        "root_sources": { "type": "array", "items": { "$ref": "#/$defs/source" } },
        "leash_duration": { "type": "number" },
        "leash_sources": { "type": "array", "items": { "$ref": "#/$defs/source" } },
        "trap_duration": { "type": "number" },
        "trap_sources": { "type": "array", "items": { "$ref": "#/$defs/source" } },
        "taunt_duration": { "type": "number" },
        "taunt_sources": { "type": "array", "items": { "$ref": "#/$defs/source" } },
        "silence_duration": { "type": "number" },
        "silence_sources": { "type": "array", "items": { "$ref": "#/$defs/source" } },
        "break_duration": { "type": "number" },
        "break_sources": { "type": "array", "items": { "$ref": "#/$defs/source" } },
        "disarm_duration": { "type": "number" },
        "disarm_sources": { "type": "array", "items": { "$ref": "#/$defs/source" } },
        "heal_duration": { "type": "number" },
        "heal_value": { "type": "number" },
        "heal_sources": { "type": "array", "items": { "$ref": "#/$defs/source" } },
        "gold_spent_wards": { "type": "integer" },
        "gold_spent_smoke": { "type": "integer" },
        "gold_spent_dust": { "type": "integer" },
        "gold_lost": { "type": "integer" },
        "camps_stacked": { "type": "integer" },
        "creeps_stacked": { "type": "integer" },
        "rune_pickups": { "type": "integer" },
        "wisdoms_captured": { "type": "integer" },
        "watchers_captured": { "type": "integer" },
        "lotuses_gathered": { "type": "integer" },
        "first_blood": { "type": "boolean" },
        "courier_kills": { "type": "integer" }
      }
    }
  }
}
